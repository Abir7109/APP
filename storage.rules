rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMember(coupleId) {
      return request.auth != null
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/couples/$(coupleId)
        ).data.memberIds;
    }

    match /couples/{coupleId}/photos/{fileName} {
      allow read: if isMember(coupleId);
      allow write: if isMember(coupleId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
