rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function coupleDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isMember(coupleId) {
      return signedIn() && request.auth.uid in coupleDoc(coupleId).memberIds;
    }

    function isJoining(coupleId) {
      return signedIn()
        && me().coupleId == null
        && !(request.auth.uid in coupleDoc(coupleId).memberIds)
        && coupleDoc(coupleId).memberIds.size() < 2;
    }

    match /users/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || resource.data.coupleId == me().coupleId);
      allow list: if signedIn() && resource.data.coupleId == me().coupleId;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /pins/{pin} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && pin.matches('^[0-9]{6}$')
        && request.resource.data.coupleId is string;
      allow update: if false;
      allow delete: if signedIn()
        && (isMember(resource.data.coupleId)
          || !exists(/databases/$(database)/documents/couples/$(resource.data.coupleId)));
    }

    match /couples/{coupleId} {
      allow get: if signedIn() && (isMember(coupleId) || isJoining(coupleId));
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isMember(coupleId)
        || (isJoining(coupleId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1);
      allow delete: if isMember(coupleId);
    }

    match /couples/{coupleId}/{collection}/{docId} {
      allow read, write: if isMember(coupleId);
    }
  }
}
